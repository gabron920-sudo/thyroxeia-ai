# ══════════════════════════════════════════════════════════════════════════════
#  Thyroxeia AI Backend — Environment Variables
#  In Railway: paste each into Variables tab (Settings → Variables)
# ══════════════════════════════════════════════════════════════════════════════

# ── Gemini AI Key Pool (up to 5 keys — backend auto-rotates on quota exhaustion)
# Get free keys at: aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY_3=your_gemini_key_3_here
GEMINI_API_KEY_4=your_gemini_key_4_here
GEMINI_API_KEY_5=your_gemini_key_5_here

# ── PayPal Live Credentials (developer.paypal.com → Apps & Credentials → Live)
PAYPAL_CLIENT_ID=Acn3s6SAOb8iSxAwv_hxXBgPRIiWOrgTXuAoRCyN58xxhcr59N2d43DJpI77lIxsQ_jIc7er_uYGCs0W
PAYPAL_CLIENT_SECRET=your_paypal_live_client_secret_here
PAYPAL_MODE=live

# ── Supabase — MUST match the project used in index.html (odyywykbaahgmnvashrs)
# ✅ Project: odyywykbaahgmnvashrs.supabase.co
SUPABASE_URL=https://odyywykbaahgmnvashrs.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9keXl3eWtiYWFoZ21udmFzaHJzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY1NzgxMDMsImV4cCI6MjA5MjE1NDEwM30.uL-T1K3vJ_v0YfC_L4DscH72uOOfA_o2O_W8N5e2_l8
# ⚠️ Service Role key — NEVER put this in frontend. Get from: Supabase → Settings → API → service_role
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── SMTP (Gmail App Password for branded emails)
# ⚠️ IMPORTANT: Use a Gmail APP PASSWORD, not your regular Gmail password
# Google Account → Security → 2-Step Verification → App passwords → Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=throyxeiaai@gmail.com
SMTP_PASS=your_16_char_app_password_here
EMAIL_FROM=Thyroxeia AI <throyxeiaai@gmail.com>

# ── Admin (set a strong secret to protect /admin/users and /admin/usage)
# Access with: curl -H "X-Admin-Key: YOUR_KEY" https://your-railway-url/admin/users
ADMIN_KEY=your_strong_secret_admin_key_here

# ── Server
PORT=3001
# Your Railway frontend URL (no trailing slash) — used for CORS
FRONTEND_URL=https://thyroxeia-deploy-production.up.railway.app
