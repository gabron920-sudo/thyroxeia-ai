# ══════════════════════════════════════════════════════════════════════════════
#  Thyroxeia AI Backend — Environment Variables
#  Copy this to .env for local dev. In Railway: paste each into Variables tab.
# ══════════════════════════════════════════════════════════════════════════════

# ── Gemini AI Key Pool (up to 5 keys — backend auto-rotates when one hits quota)
# Get free keys at: aistudio.google.com/app/apikey
# ✅ REQUIRED — at least GEMINI_API_KEY must be set
GEMINI_API_KEY=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY_3=your_gemini_key_3_here
GEMINI_API_KEY_4=your_gemini_key_4_here
GEMINI_API_KEY_5=your_gemini_key_5_here

# ── PayPal (live credentials from developer.paypal.com → your app)
# ✅ REQUIRED for payments
PAYPAL_CLIENT_ID=your_paypal_live_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_live_client_secret_here
PAYPAL_MODE=live
# Set PAYPAL_MODE=sandbox for testing with sandbox.paypal.com

# ── Supabase — MUST match the project your frontend uses
# ✅ REQUIRED for plan activation, auth verification, and AI usage tracking
SUPABASE_URL=https://odyywykbaahgmnvashrs.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9keXl3eWtiYWFoZ21udmFzaHJzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY1NzgxMDMsImV4cCI6MjA5MjE1NDEwM30.uL-T1K3vJ_v0YfC_L4DscH72uOOfA_o2O_W8N5e2_l8
# ⚠️  Service Role key — NEVER put this in frontend. Supabase → Settings → API → service_role
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── SMTP (branded emails — OTP, welcome, elite welcome)
# Gmail App Password: Google Account → Security → 2-Step Verification → App passwords
# ✅ REQUIRED for email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=throyxeiaai@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=Thyroxeia AI <throyxeiaai@gmail.com>

# ── Admin panel (protect /admin/users and /admin/usage)
# ✅ REQUIRED to access user list and payment proof
# Set this to any strong random string — keep it secret
ADMIN_KEY=your_strong_random_admin_key_here

# ── Server
PORT=3001
# Your frontend URL — used for CORS (Railway serves frontend, so use Railway URL)
FRONTEND_URL=https://thyroxeia-deploy-production.up.railway.app
